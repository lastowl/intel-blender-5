From 5cda2809c438ef80517135baffa32e35ffc4afe9 Mon Sep 17 00:00:00 2001
From: Tom Hodgson <tom@justsanity.com>
Date: Sat, 15 Aug 2026 23:11:49 +0100
Subject: [PATCH 3/4] deps: only add clang ASM flags to x265 on Apple Silicon

x265_apple.diff appends -isysroot and -mmacosx-version-min to x265's
ASM_FLAGS for all Apple builds. On arm64 the assembler is clang, which
understands them. On x86_64 x265 assembles with nasm, which does not:

  nasm: error: unrecognised option `-m'

(nasm reports long options by their first character, so this is
-mmacosx-version-min.) The flags are only meaningful for the clang-based
arm64 path, so guard on ARM64. Upstream only ships arm64 for macOS now,
which is why this went unnoticed.
---
 build_files/build_environment/patches/x265_apple.diff | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/build_files/build_environment/patches/x265_apple.diff b/build_files/build_environment/patches/x265_apple.diff
index acba101e1f0..391803746f8 100644
--- a/build_files/build_environment/patches/x265_apple.diff
+++ b/build_files/build_environment/patches/x265_apple.diff
@@ -6,7 +6,7 @@ index ab5ddfe..50e9a05 100755
    endif()
  endif(ARM64)
  
-+if(APPLE)
++if(APPLE AND ARM64)
 +  list(APPEND ASM_FLAGS -isysroot ${CMAKE_OSX_SYSROOT} -mmacosx-version-min=${CMAKE_OSX_DEPLOYMENT_TARGET})
 +endif()
 +
